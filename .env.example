# Leandro Santana Cerimonial — Variáveis de Ambiente

# URL pública do site (utilizado em sitemap, robots, OpenGraph e canonical)
NEXT_PUBLIC_SITE_URL=https://www.leandrosantanacerimonial.com.br

# Endpoint do serviço de envio de formulário (Formspree ou Web3Forms)
# Exemplo Web3Forms: https://api.web3forms.com/submit (com chave)
# Exemplo Formspree: https://formspree.io/f/SEU_FORM_ID
# Se vazio, o formulário faz fallback gracioso diretamente para o WhatsApp!
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/SEU_FORM_ID_AQUI
